rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCustomer(data) {
      return data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 100 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20));
    }

    function isValidTransaction(data) {
      return isValidId(data.customerId) &&
             data.type in ['CREDIT', 'PAYMENT'] &&
             data.amount is int &&
             data.amount > 0 &&
             data.amount <= 100000000000 &&
             data.transactionDate is timestamp &&
             (!('note' in data) || (data.note is string && data.note.size() <= 300));
    }

    match /users/{userId} {
      match /customers/{customerId} {
        allow get: if isOwner(userId) && isValidId(customerId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(customerId) &&
                         incoming().keys().hasAll(['name', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['name', 'phone', 'createdAt', 'updatedAt']) &&
                         isValidCustomer(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time;

        allow update: if isOwner(userId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming()) &&
                         incoming().keys().hasOnly(['name', 'phone', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(customerId);
      }

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll(['customerId', 'type', 'amount', 'transactionDate', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['customerId', 'type', 'amount', 'note', 'transactionDate', 'createdAt', 'updatedAt']) &&
                         isValidTransaction(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         exists(/databases/$(database)/documents/users/$(userId)/customers/$(incoming().customerId));

        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().keys().hasOnly(['customerId', 'type', 'amount', 'note', 'transactionDate', 'createdAt', 'updatedAt']) &&
                         incoming().customerId == existing().customerId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'note', 'transactionDate', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
